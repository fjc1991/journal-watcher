# Keys are normally saved for you (Settings → AI & privacy). By hand: the real .env lives in your DATA folder (JW_HOME), next to Papers/. Never commit it.
ANTHROPIC_API_KEY=
UNPAYWALL_EMAIL=you@example.com
# Optional: Elsevier developer API key (https://dev.elsevier.com) for scripted DSS downloads
ELSEVIER_API_KEY=
# Optional AI providers for the reader's Ask tab (pick one per feature with the gear in the reader; Ollama needs no key)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
